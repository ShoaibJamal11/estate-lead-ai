# EstateLead AI - Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to version control.

# Groq / Llama API Key (for server-side AI responses)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (alternative LLM provider)
OPENAI_API_KEY=your_openai_api_key_here

# CRM Webhook URL (n8n / Make / Zapier endpoint for lead dispatch)
CRM_WEBHOOK_URL=https://your-n8n-instance.com/webhook/leads
